<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shop_fake_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tab_all_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="전체"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="#000000"
            app:layout_constraintEnd_toEndOf="@id/tab_all_tv"
            app:layout_constraintStart_toStartOf="@id/tab_all_tv"
            app:layout_constraintTop_toBottomOf="@id/tab_all_tv" />

        <TextView
            android:id="@+id/tab_tops_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="Tops &amp; T-Shirts"
            android:textColor="#8D8D8D"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/tab_all_tv"
            app:layout_constraintStart_toEndOf="@id/tab_all_tv"
            app:layout_constraintTop_toTopOf="@id/tab_all_tv" />

        <TextView
            android:id="@+id/tab_sale_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="sale"
            android:textColor="#8D8D8D"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/tab_tops_tv"
            app:layout_constraintStart_toEndOf="@id/tab_tops_tv"
            app:layout_constraintTop_toTopOf="@id/tab_tops_tv" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shop_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shop_fake_tab_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>