<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"> <ImageView
    android:id="@+id/item_product_img_iv"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:background="#F6F6F6"
    android:scaleType="centerInside"
    android:padding="15dp"
    android:src="@drawable/air_jordan"
    app:layout_constraintDimensionRatio="1:1"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/item_product_heart_iv"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/emptyheart"
        app:layout_constraintEnd_toEndOf="@id/item_product_img_iv"
        app:layout_constraintTop_toTopOf="@id/item_product_img_iv" />

    <TextView
        android:id="@+id/item_product_tag_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="BestSeller"
        android:textColor="#FF5722"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_product_img_iv" />

    <TextView
        android:id="@+id/item_product_name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nike Air Force 1 '07"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_product_tag_tv" />

    <TextView
        android:id="@+id/item_product_desc_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Women's Shoes"
        android:textColor="#8D8D8D"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_product_name_tv" />

    <TextView
        android:id="@+id/item_product_colors_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="5 Colours"
        android:textColor="#8D8D8D"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_product_desc_tv" />

    <TextView
        android:id="@+id/item_product_price_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="US$115"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_product_colors_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>