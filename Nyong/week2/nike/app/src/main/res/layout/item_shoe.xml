<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_shoe_image"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="#F5F5F5"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@drawable/ic_launcher_background" />

    <TextView
        android:id="@+id/tv_shoe_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/iv_shoe_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Nike Everyday Plus Cushioned" />

    <TextView
        android:id="@+id/tv_shoe_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_shoe_name"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Training Ankle Socks (6 Pairs)" />

    <TextView
        android:id="@+id/tv_shoe_colors"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_shoe_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="5 Colours" />

    <TextView
        android:id="@+id/tv_shoe_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_shoe_colors"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="US$10" />

</androidx.constraintlayout.widget.ConstraintLayout>