<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CheckoutFragment">

<com.google.android.material.tabs.TabLayout
    android:id="@+id/checkout_tab_layout"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@color/white"
    app:tabMode="scrollable"
    app:tabContentStart="0dp"
    app:tabGravity="start"
    app:tabPaddingStart="24dp"
    app:tabPaddingEnd="24dp"
    app:tabIndicatorFullWidth="true"
    app:tabIndicatorColor="@color/black"
    app:tabSelectedTextColor="@color/black"
    app:tabTextColor="#767676"
    app:tabRippleColor="@android:color/transparent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <com.google.android.material.tabs.TabItem
        android:id="@+id/checkout_tab_all"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="전체" />

    <com.google.android.material.tabs.TabItem
        android:id="@+id/checkout_tab_tops"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="Tops&amp;T-Shirts" />

    <com.google.android.material.tabs.TabItem
        android:id="@+id/checkout_tab_shoes"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="Shoes" />

</com.google.android.material.tabs.TabLayout>


</androidx.constraintlayout.widget.ConstraintLayout>