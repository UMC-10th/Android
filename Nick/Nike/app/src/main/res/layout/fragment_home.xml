<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_title_TV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textAppearance="@style/title"
                android:includeFontPadding="false"


                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                android:layout_marginTop="100dp"
                android:layout_marginStart="41dp"
                android:layout_marginEnd="41dp"/>

            <TextView
                android:id="@+id/home_today_TV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_today"
                android:textAppearance="@style/r16_gray"
                android:includeFontPadding="false"


                app:layout_constraintTop_toBottomOf="@id/home_title_TV"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                android:layout_marginStart="41dp"
                android:layout_marginEnd="41dp"
                android:layout_marginTop="10dp"/>

            <ImageView
                android:id="@+id/home_banner_TV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/image_home_banner"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_today_TV"

                android:layout_marginTop="50dp"/>

            <TextView
                android:id="@+id/home_new_title_TV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_new"

                app:layout_constraintTop_toBottomOf="@id/home_banner_TV"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"
                android:layout_marginTop="40dp"/>

            <TextView
                android:id="@+id/home_new_subtitle_TV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_new_sub"

                app:layout_constraintTop_toBottomOf="@id/home_new_title_TV"
                android:layout_marginTop="12dp"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_new_RV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:layout_constraintTop_toBottomOf="@id/home_new_subtitle_TV"
                android:layout_marginStart="42dp"
                android:layout_marginTop="22dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>